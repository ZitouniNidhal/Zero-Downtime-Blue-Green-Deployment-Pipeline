# Docker Image & Container Configuration
IMAGE_NAME=bluegreen-app
REGISTRY=ghcr.io
BLUE_TAG=v1
GREEN_TAG=v1

# Shared Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://app:app@db:5432/appdb
DB_HOST=db
DB_PORT=5432
DB_NAME=appdb
DB_USER=app
DB_PASSWORD=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=appdb

# Deployment Server Configuration
DEPLOY_HOST=your-server-ip
DEPLOY_USER=deploy_user
DEPLOY_PORT=22
DEPLOY_PATH=/opt/bluegreen-deploy
DEPLOY_SSH_PASSPHRASE=

# Application Environment Configuration
FLASK_ENV=production
FLASK_DEBUG=0
LOG_LEVEL=INFO

# Nginx & Reverse Proxy Configuration
NGINX_PORT=80

# Monitoring Stack Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
CADVISOR_PORT=8080

# Health Check Settings (pre-switch verification)
HEALTH_CHECK_RETRIES=10
HEALTH_CHECK_INTERVAL=3
HEALTH_CHECK_TIMEOUT=5

